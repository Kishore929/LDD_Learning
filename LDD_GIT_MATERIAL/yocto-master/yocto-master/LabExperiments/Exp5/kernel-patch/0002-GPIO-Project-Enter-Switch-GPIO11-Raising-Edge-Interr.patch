From 8b12e9e0366976837b3be10440f0444b39cbfa9c Mon Sep 17 00:00:00 2001
From: Kishore Kumar Boddu <kishore@kernelmasters.org>
Date: Wed, 20 Apr 2022 22:44:42 +0530
Subject: [PATCH 2/2] GPIO Project:Enter Switch (GPIO11: Raising Edge
 Interrupt) porting on KM-BBB target board

---
 Makefile                            |  2 +-
 arch/arm/boot/dts/km-bbb-am335x.dts | 24 +++++++++++++++++++++++-
 drivers/input/keyboard/gpio_keys.c  |  2 ++
 3 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 3c892a771..7230980d1 100644
--- a/Makefile
+++ b/Makefile
@@ -2,7 +2,7 @@
 VERSION = 4
 PATCHLEVEL = 19
 SUBLEVEL = 94
-EXTRAVERSION =
+EXTRAVERSION = gpio-project
 NAME = "People's Front"
 
 # *DOCUMENTATION*
diff --git a/arch/arm/boot/dts/km-bbb-am335x.dts b/arch/arm/boot/dts/km-bbb-am335x.dts
index 7ebe756fe..f8dd33cf5 100644
--- a/arch/arm/boot/dts/km-bbb-am335x.dts
+++ b/arch/arm/boot/dts/km-bbb-am335x.dts
@@ -31,6 +31,22 @@
                 regulator-max-microvolt = <3300000>;
         };
 
+	gpio_keys: volume_key0 {
+                compatible = "gpio-keys";
+                pinctrl-names = "default";
+                pinctrl-0 = <&km_gpio_pins>;
+		autorepeat;
+
+	        switch11 {
+                        label = "enter";
+                        linux,code = <28>;
+                        /*linux,code = <KEY_ENTER>;*/
+                        gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
+                        wakeup-source;
+                };
+	};
+
+
 };
 
 &am33xx_pinmux {
@@ -40,9 +56,15 @@
                         AM33XX_IOPAD(0x974, PIN_OUTPUT_PULLDOWN | MUX_MODE0)    /* uart0_txd.uart0_txd */
                         AM33XX_IOPAD(0x8D4, MUX_MODE7)  				     /* lcd_data13.gpio0_9 (Buzzer) */
                         AM33XX_IOPAD(0x8D8, MUX_MODE7)					     /* lcd_data14.gpio0_10(RED LED)*/
-                        AM33XX_IOPAD(0x8DC, PIN_INPUT | PIN_INPUT_PULLDOWN | MUX_MODE7)      /* lcd_data15.gpio0_11(ENT_SW) */
                 >;
         };
+	km_gpio_pins: pinmux_km_gpio_pins {
+		pinctrl-single,pins = <
+			AM33XX_IOPAD(0x8DC, PIN_INPUT | PIN_INPUT_PULLDOWN | MUX_MODE7)      /* lcd_data15.gpio0_11(ENT_SW) */
+		>;
+	};
+
+
 
         mmc1_pins: pinmux_mmc1_pins {   /* mmc1[mmc0]-SDCARD; mmc2[mmc1]-eMMC */
                 pinctrl-single,pins = <
diff --git a/drivers/input/keyboard/gpio_keys.c b/drivers/input/keyboard/gpio_keys.c
index 492a971b9..8c3e316f3 100644
--- a/drivers/input/keyboard/gpio_keys.c
+++ b/drivers/input/keyboard/gpio_keys.c
@@ -778,6 +778,7 @@ static int gpio_keys_probe(struct platform_device *pdev)
 	int i, error;
 	int wakeup = 0;
 
+	printk("%s:%s:%d\n",__FILE__,__func__,__LINE__);
 	if (!pdata) {
 		pdata = gpio_keys_get_devtree_pdata(dev);
 		if (IS_ERR(pdata))
@@ -872,6 +873,7 @@ static int gpio_keys_probe(struct platform_device *pdev)
 
 	device_init_wakeup(dev, wakeup);
 
+	printk("%s:%s:%d\n",__FILE__,__func__,__LINE__);
 	return 0;
 }
 
-- 
2.17.1

