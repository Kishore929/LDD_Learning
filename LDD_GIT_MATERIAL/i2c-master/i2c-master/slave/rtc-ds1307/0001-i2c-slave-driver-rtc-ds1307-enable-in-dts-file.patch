From f1a8654b6d688c531d5caf3a6c1fc7fcc834f543 Mon Sep 17 00:00:00 2001
From: Kishore Kumar Boddu <kishore@kernelmasters.org>
Date: Thu, 11 Aug 2022 21:13:22 +0530
Subject: [PATCH] i2c slave driver (rtc-ds1307) enable in dts file

---
 arch/arm/boot/dts/km-bbb-am335x.dts | 5 +++++
 drivers/rtc/rtc-ds1307.c            | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/arch/arm/boot/dts/km-bbb-am335x.dts b/arch/arm/boot/dts/km-bbb-am335x.dts
index 3bdabe66d..4763ee9f7 100644
--- a/arch/arm/boot/dts/km-bbb-am335x.dts
+++ b/arch/arm/boot/dts/km-bbb-am335x.dts
@@ -71,5 +71,10 @@
           status = "okay";
           clock-frequency = <100000>;
           symlink = "bone/i2c/0";
+	rtc1: ds1307@68 {
+                compatible = "dallas,ds1307";
+                reg = <0x68>;
+        };
+
 };
 
diff --git a/drivers/rtc/rtc-ds1307.c b/drivers/rtc/rtc-ds1307.c
index 71396b62d..45c786601 100644
--- a/drivers/rtc/rtc-ds1307.c
+++ b/drivers/rtc/rtc-ds1307.c
@@ -1399,6 +1399,8 @@ static int ds1307_probe(struct i2c_client *client,
 	struct ds1307_platform_data *pdata = dev_get_platdata(&client->dev);
 	u8			trickle_charger_setup = 0;
 
+	printk("%s:%s:%d\n",__FILE__,__func__,__LINE__);
+
 	ds1307 = devm_kzalloc(&client->dev, sizeof(struct ds1307), GFP_KERNEL);
 	if (!ds1307)
 		return -ENOMEM;
@@ -1732,6 +1734,7 @@ read_rtc:
 	ds1307_hwmon_register(ds1307);
 	ds1307_clks_register(ds1307);
 
+	printk("%s:%s:%d\n",__FILE__,__func__,__LINE__);
 	return 0;
 
 exit:
-- 
2.17.1

